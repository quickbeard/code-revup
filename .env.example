# Copy to .env and fill in your values: cp .env.example .env

# OpenRouter API key (https://openrouter.ai/keys). Required.
API_KEY=

# OpenRouter API base URL. A full endpoint URL ending in /chat/completions also works.
BASE_URL=https://openrouter.ai/api/v1

# OpenRouter model id used by every agent (https://openrouter.ai/models). Required.
MODEL=anthropic/claude-sonnet-5.5

# Optional: GitHub token for `code-revup fetch`. Raises the API rate limit (60 requests/hour without).
GITHUB_TOKEN=
